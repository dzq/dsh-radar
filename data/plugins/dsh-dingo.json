{
  "slug": "dsh-dingo",
  "name": "dsh-dingo",
  "version": "1.0.0",
  "description": "DSH 声音提醒 + 对话直达插件：多对话并行时，哪个对话有回复就出声提醒，点右上角卡片直达对应对话；切到别的应用时还有系统级通知（macOS 通知中心 / Windows toast），点击直达。当前对话当/当当（crisp 档），其他对话叮/叮叮（soft 档）。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "notification",
    "alert",
    "tone",
    "reminder",
    "interjection",
    "session"
  ],
  "license": "MIT",
  "repo": "",
  "homepage": "",
  "npm": "https://www.npmjs.com/package/dsh-dingo",
  "dsh_compat": true,
  "dsh_meta": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-conversation",
