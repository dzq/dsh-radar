# =============================================================================
# DSH Radar 公开环境变量配置
# =============================================================================
# 复制此文件为 .env，然后填入真实值（部署到 Cloudflare Pages / Vercel / Netlify 都支持）
# 本地开发：把 .env 放在 web/ 目录下，Astro 会自动读取
#
# 这些变量以 PUBLIC_ 开头，会在浏览器端可见（用于前端脚本）
# =============================================================================

# ─── Web3Forms ────────────────────────────────────────────────────────────
# 注册: https://web3forms.com/ （完全免费，无提交上限）
# 注册后自动获得 access_key（形如 a1b2c3d4-e5f6-7890-abcd-ef1234567890）
# 留空 → 表单回退到 mailto:subscribe@dsh.pub / mailto:sales@dsh.pub
PUBLIC_WEB3FORMS_KEY=

# ─── Plausible Analytics ─────────────────────────────────────────────────
# 注册: https://plausible.io/ （免费 30 天试用，或自托管 plausible/analytics）
# 站点名填你的域名（如 dsh.pub），不要带协议
# 留空 → 完全不上报（默认零追踪行为）
PUBLIC_PLAUSIBLE_DOMAIN=
