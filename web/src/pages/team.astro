---
import Layout from '../layouts/Layout.astro';
import { loadJson } from '../lib/paths.mjs';

const stats = await loadJson('stats.json');
const index = await loadJson('index.json');

// Web3Forms access key: 通过 PUBLIC_WEB3FORMS_KEY 环境变量配置
// 不填则表单回退到 mailto
const web3formsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY || '';
const contactAction = web3formsKey
  ? 'https://api.web3forms.com/submit'
  : 'mailto:sales@dsh.pub';

const tiers = [
  {
    name: 'Free',
    price: '$0',
    period: '永久免费',
    color: '#8b96a8',
    desc: '个人开发者 / 爱好者',
    features: [
      '✅ 全部插件雷达评分',
      '✅ 版本兼容矩阵',
      '✅ 公开配方库',
      '✅ RSS / Atom / JSON Feed 订阅',
      '✅ 踩坑 Wiki 浏览',
      '❌ 团队插件白名单',
      '❌ 共享 profile',
      '❌ 权限审计',
      '❌ 私有 registry 镜像',
      '❌ SLA / 7×24 支持',
    ],
    cta: '开始使用',
    href: '/plugins',
    highlighted: false,
  },
  {
    name: 'Team',
    price: '$19',
    period: '/ seat / 月',
    color: '#5eead4',
    desc: '5-50 人研发团队',
    features: [
      '✅ Free 全部功能',
      '✅ 团队插件白名单（治理谁能装什么）',
      '✅ 共享 profile + 角色继承',
      '✅ 安装/卸载审计日志',
      '✅ 危险插件自动拦截',
      '✅ 内部 registry 镜像',
      '✅ 飞书 / 钉钉 / Slack 变更通知',
      '✅ 团队 weekly 报告',
      '❌ 私有 SaaS 部署',
      '❌ 定制合规扫描',
    ],
    cta: '14 天免费试用',
    href: '#contact',
    highlighted: true,
  },
  {
    name: 'Enterprise',
    price: '联系销售',
    period: '年付 / 议价',
    color: '#a78bfa',
    desc: '50+ 人 / 金融 / 政企',
    features: [
      '✅ Team 全部功能',
      '✅ 私有化部署（VPC / 离线）',
      '✅ SSO + SCIM',
      '✅ 等保 / SOC2 合规扫描',
      '✅ 私有 registry + 镜像代理',
      '✅ 7×24 紧急响应',
      '✅ 定制插件评估',
      '✅ 专属客户成功经理',
      '✅ 季度合规报告',
      '✅ SLA 99.95%',
    ],
    cta: '联系销售',
    href: '#contact',
    highlighted: false,
  },
];

const faqs = [
  {
    q: 'Team 版是基于 DSH Radar 数据吗？',
    a: '是。我们每周自动同步 npm 上 700+ 个 dsh-plugin 包的元数据、GitHub 仓库活跃度、安全审计关键词。你团队的"白名单 / 黑名单"基于这些数据决策。',
  },
  {
    q: '会不会锁死我们只能装白名单插件？',
    a: '不。Team 版提供软治理 —— 不在白名单的插件会被警告（但仍可装，需管理员审批），不会硬阻断。这平衡了研发自由度和合规可追溯。',
  },
  {
    q: '支持私有 npm registry 吗？',
    a: 'Team 版内置镜像代理，把 dsh-radar 的评分叠加到你的私有 registry 上，让内部插件也能被评分。Enterprise 版支持完全私有 registry + 离线部署。',
  },
  {
    q: '能不能不订阅就拿到数据？',
    a: '可以。完整数据在 GitHub repo 的 data/ 目录，MIT 协议，随便用。付费的是管理界面 + 自动化。',
  },
  {
    q: '和 DeepSeek 官方有关系吗？',
    a: '没有。DSH Radar 是社区项目，不隶属于 DeepSeek。我们只是聚合 npm + GitHub 上的公开数据。',
  },
  {
    q: '怎么验证你们不是来割韭菜的？',
    a: '团队来自一线开发者（自用），定价基于节省的工时，不融资不烧钱。可以先 Free 用 6 个月，觉得值再付费。',
  },
];
---
<Layout title="团队版 — DSH Radar" active="team">
  {/* Hero */}
  <section class="hero" style="padding:64px 24px 40px;">
    <div class="container">
      <h1>团队版 🚀</h1>
      <p class="tagline">
        让团队用 DSH 不踩坑 — <strong>插件白名单 + 审计 + 私有 registry</strong>
      </p>
      <div class="cta">
        <a href="#pricing" class="btn btn-primary">查看定价 →</a>
        <a href="#contact" class="btn">联系销售</a>
      </div>
    </div>
  </section>

  {/* 数据背景 */}
  <section class="container">
    <div class="stats-grid">
      <div class="stat-card">
        <span class="num">{stats.total}+</span>
        <span class="label">评分插件</span>
      </div>
      <div class="stat-card">
        <span class="num">{stats.by_grade.D || 0}+</span>
        <span class="label">D 级高危插件</span>
      </div>
      <div class="stat-card">
        <span class="num">5</span>
        <span class="label">真实踩坑</span>
      </div>
      <div class="stat-card">
        <span class="num">708</span>
        <span class="label">npm 标签总数</span>
      </div>
    </div>
  </section>

  {/* 痛点 */}
  <section class="container section">
    <h2>研发团队用 DSH 的 4 大痛点</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px;margin-top:24px;">
      <div class="info-block" style="margin:0;border-left:3px solid var(--bad);">
        <h3>😱 1. 插件质量参差</h3>
        <p style="color:var(--text-dim);font-size:14px;">npm 上 700+ 个 dsh-plugin 包，质量天差地别。一个 D 级插件可能引入 RCE。</p>
      </div>
      <div class="info-block" style="margin:0;border-left:3px solid var(--warn);">
        <h3>😱 2. AI 擅自提交</h3>
        <p style="color:var(--text-dim);font-size:14px;">Agent 拿到写权限后直接 commit + push 到 main。SMZDM 上"4 道防线"文章就是写给这种事的。</p>
      </div>
      <div class="info-block" style="margin:0;border-left:3px solid #fb923c;">
        <h3>📦 3. 升级全炸</h3>
        <p style="color:var(--text-dim);font-size:14px;">DSH rc 版 API 频繁变动，团队 20 个插件同时不兼容。没人测谁兼容谁。</p>
      </div>
      <div class="info-block" style="margin:0;border-left:3px solid var(--accent);">
        <h3>👥 4. 协作不可见</h3>
        <p style="color:var(--text-dim);font-size:14px;">谁装了危险插件？团队的"标准插件组合"是什么？没人知道，审计无从下手。</p>
      </div>
    </div>
  </section>

  {/* 定价 */}
  <section class="container section" id="pricing">
    <h2>💰 定价</h2>
    <p class="sub">按席位计费 · 年付 8 折 · Free 永远免费</p>

    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:16px;margin-top:24px;">
      {tiers.map((t) => (
        <div class="info-block" style={`margin:0;border-top:3px solid ${t.color};${t.highlighted ? 'box-shadow:0 0 24px rgba(94,234,212,0.2);' : ''}`}>
          {t.highlighted && <div style="display:inline-block;background:var(--accent);color:#0a0e1a;padding:2px 10px;border-radius:4px;font-size:11px;font-weight:700;margin-bottom:12px;">⭐ 最受欢迎</div>}
          <h3 style={`font-size:22px;color:${t.color};`}>{t.name}</h3>
          <p style="font-size:12px;color:var(--text-mute);margin:4px 0 12px;">{t.desc}</p>
          <div style="margin:16px 0;">
            <span style={`font-size:36px;font-weight:800;color:${t.color};font-family:monospace;`}>{t.price}</span>
            <span style="color:var(--text-mute);font-size:14px;margin-left:6px;">{t.period}</span>
          </div>
          <ul style="list-style:none;padding:0;margin:16px 0;font-size:14px;">
            {t.features.map((f) => (
              <li style={`padding:6px 0;color:${f.startsWith('❌') ? 'var(--text-mute)' : 'var(--text)'};`}>
                {f}
              </li>
            ))}
          </ul>
          <a href={t.href} class={`btn ${t.highlighted ? 'btn-primary' : ''}`} style="width:100%;justify-content:center;margin-top:12px;">
            {t.cta}
          </a>
        </div>
      ))}
    </div>
  </section>

  {/* Team 版特性详解 */}
  <section class="container section">
    <h2>🛠️ Team 版核心特性</h2>

    <div style="display:grid;gap:20px;margin-top:24px;">
      <div class="info-block">
        <h3>1️⃣ 团队插件白名单</h3>
        <p style="color:var(--text-dim);">
          管理员在 dashboard 设定"团队允许 / 禁止 / 需审批"的插件列表。
          团队成员 dsh install 时被自动拦截或提示审批。
          基于 DSH Radar 的 S/A/B/C/D 评分自动推荐白名单起点。
        </p>
        <pre style="background:var(--bg);padding:12px;border-radius:6px;color:var(--accent);font-size:12px;margin-top:12px;overflow-x:auto;"><code>{`{
  "whitelist": {
    "auto_allow": ["grade-S", "grade-A"],
    "require_approval": ["grade-B"],
    "auto_deny": ["grade-D"]
  }
}`}</code></pre>
      </div>

      <div class="info-block">
        <h3>2️⃣ 共享 Profile + 角色继承</h3>
        <p style="color:var(--text-dim);">
          一次定义，全员生效。前端 / 后端 / QA / SRE 各自的"标准插件组合"。
          新人入职 onboarding 自动装好团队标准。
        </p>
        <pre style="background:var(--bg);padding:12px;border-radius:6px;color:var(--accent);font-size:12px;margin-top:12px;overflow-x:auto;"><code>{`{
  "profile": "frontend-team",
  "inherits": ["company-base"],
  "plugins": [
    "@liustack/modsearch",
    "@liustack/pptfast",
    "dsh-plugin-review"
  ]
}`}</code></pre>
      </div>

      <div class="info-block">
        <h3>3️⃣ 安装/卸载审计日志</h3>
        <p style="color:var(--text-dim);">
          谁、什么时候、装了什么插件 — 完整留痕。
          配合 DSH Radar 的版本兼容矩阵，自动告警"装了 rc 不兼容的插件"。
        </p>
      </div>

      <div class="info-block">
        <h3>4️⃣ 内部 Registry 镜像</h3>
        <p style="color:var(--text-dim);">
          把团队的私有插件 + npm 公开插件统一镜像到内部 registry。
          DSH Radar 的评分叠加到私有插件上，让团队透明看到内部插件质量。
        </p>
      </div>

      <div class="info-block">
        <h3>5️⃣ 飞书 / 钉钉 / Slack 变更通知</h3>
        <p style="color:var(--text-dim);">
          插件评分变化、版本不兼容、危险插件被安装 — 实时推送到团队 IM。
          webhook 模板开箱即用。
        </p>
      </div>

      <div class="info-block">
        <h3>6️⃣ 团队 Weekly 报告</h3>
        <p style="color:var(--text-dim);">
          每周一自动发到团队邮箱：本周边界变化、新增插件、Top10 升级、风险清单。
        </p>
      </div>
    </div>
  </section>

  {/* 安全合规 */}
  <section class="container section">
    <h2>🔒 安全 & 合规</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px;margin-top:24px;">
      <div class="info-block" style="margin:0;">
        <h3>📋 数据来源透明</h3>
        <p style="color:var(--text-dim);font-size:14px;">所有评分基于 npm registry + GitHub API 公开数据，无人工黑箱。</p>
      </div>
      <div class="info-block" style="margin:0;">
        <h3>🔐 私有化部署</h3>
        <p style="color:var(--text-dim);font-size:14px;">Enterprise 版支持 VPC 内离线部署，数据不出域。</p>
      </div>
      <div class="info-block" style="margin:0;">
        <h3>🪪 SSO + SCIM</h3>
        <p style="color:var(--text-dim);font-size:14px;">对接企业 IdP（Okta / Azure AD / 飞书 OIDC），自动开通。</p>
      </div>
      <div class="info-block" style="margin:0;">
        <h3>📜 合规扫描</h3>
        <p style="color:var(--text-dim);font-size:14px;">插件 LICENSE 识别 · GPL 警告 · 已知 CVE 比对。</p>
      </div>
    </div>
  </section>

  {/* FAQ */}
  <section class="container section">
    <h2>❓ 常见问题</h2>
    <div style="display:grid;gap:16px;margin-top:24px;">
      {faqs.map((f) => (
        <details class="info-block" style="margin:0;cursor:pointer;">
          <summary style="font-weight:600;color:var(--text);padding:0;font-size:16px;">{f.q}</summary>
          <p style="color:var(--text-dim);margin-top:12px;font-size:14px;line-height:1.7;">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  {/* 联系销售 */}
  <section class="container section" id="contact">
    <div class="info-block" style="background:linear-gradient(135deg,rgba(94,234,212,0.08),rgba(125,211,252,0.05));border-color:var(--accent);">
      <h2 style="margin-bottom:8px;">📞 联系销售 / 申请试用</h2>
      <p style="color:var(--text-dim);margin-bottom:20px;">
        我们会在 1 个工作日内回复。所有套餐都支持<strong>14 天无理由退款</strong>。
      </p>

      <form
        action={contactAction}
        method="POST"
        style="display:grid;gap:12px;max-width:560px;"
      >
        <input type="hidden" name="access_key" value={web3formsKey} />
        <input type="hidden" name="subject" value="DSH Radar 团队版申请" />
        <input type="hidden" name="from_name" value="DSH Radar Contact Form" />
        <input type="hidden" name="botcheck" />
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
          <input required name="name" placeholder="姓名" style="padding:10px 14px;background:var(--bg);border:1px solid var(--border);border-radius:6px;color:var(--text);"/>
          <input required name="company" placeholder="公司 / 团队" style="padding:10px 14px;background:var(--bg);border:1px solid var(--border);border-radius:6px;color:var(--text);"/>
        </div>
        <input required type="email" name="email" placeholder="工作邮箱" style="padding:10px 14px;background:var(--bg);border:1px solid var(--border);border-radius:6px;color:var(--text);"/>
        <select name="seats" style="padding:10px 14px;background:var(--bg);border:1px solid var(--border);border-radius:6px;color:var(--text);">
          <option value="">团队规模（选填）</option>
          <option>5-10 人</option>
          <option>11-50 人</option>
          <option>51-200 人</option>
          <option>200+ 人</option>
        </select>
        <textarea name="msg" rows="3" placeholder="想了解什么？（选填）" style="padding:10px 14px;background:var(--bg);border:1px solid var(--border);border-radius:6px;color:var(--text);font-family:inherit;"></textarea>
        <button type="submit" class="btn btn-primary" style="justify-self:start;">提交申请 →</button>
      </form>

      <p style="margin-top:20px;font-size:13px;color:var(--text-mute);">
        或直接邮件：<a href="mailto:sales@dsh.pub">sales@dsh.pub</a>
        {!web3formsKey && <span> · ⚠️ Web3Forms 未配置，当前回退到 mailto</span>}
      </p>
    </div>
  </section>
</Layout>
