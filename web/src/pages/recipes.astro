---
import Layout from '../layouts/Layout.astro';
import { loadJson } from '../lib/paths.mjs';

const recipes = await loadJson('recipes.json');
---
<Layout title="实战配方 — DSH Radar" active="recipes">
  <section class="container section">
    <h1 style="font-size:36px;margin-bottom:8px;">📖 实战配方</h1>
    <p class="sub">社区贡献的"任务 → 插件组合 → 实测 tips" · 共 {recipes.length} 个配方</p>

    <div class="lead">
      装完插件不知道怎么用？来这里看<strong>真实场景下的插件组合</strong>。
      每个配方都有：任务描述、推荐插件、为什么这么选、踩坑 tips。
    </div>

    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(360px,1fr));gap:20px;margin-top:32px;">
      {recipes.map((r: any) => (
        <div class="info-block" style="margin:0;">
          <h3 style="font-size:18px;color:var(--text);margin-bottom:4px;">{r.title}</h3>
          <p style="font-size:13px;color:var(--text-mute);margin-bottom:12px;">任务：{r.task}</p>

          <div style="margin:12px 0;">
            <h4 style="font-size:12px;text-transform:uppercase;color:var(--text-mute);letter-spacing:0.5px;margin-bottom:8px;">推荐插件</h4>
            <div class="tags">
              {r.plugins.map((pl: string) => <span class="tag dsh">{pl}</span>)}
            </div>
          </div>

          <p style="font-size:14px;color:var(--text);margin:12px 0;"><strong>为什么：</strong>{r.why}</p>
          <p style="font-size:13px;color:var(--text-dim);background:var(--bg);padding:10px 12px;border-radius:6px;border-left:3px solid var(--accent);margin-top:8px;">
            💡 {r.tip}
          </p>

          <p style="font-size:12px;color:var(--text-mute);margin-top:16px;border-top:1px solid var(--border);padding-top:12px;">
            ♥ {r.likes} · @{r.submitted_by} · {r.submitted_at}
          </p>
        </div>
      ))}
    </div>

    <div class="empty" style="margin-top:48px;">
      <h3 style="color:var(--text);margin-bottom:8px;">想贡献一个配方？</h3>
      <p>编辑 <code>data/recipes.json</code> 提交 PR，或在 GitHub Issue 里描述你的场景。</p>
      <a href="https://github.com/dsh-radar/dsh-radar/blob/main/data/recipes.json" class="btn" style="margin-top:16px;">📝 提交配方</a>
    </div>
  </section>
</Layout>
