---
import Layout from '../layouts/Layout.astro';
import { loadJson } from '../lib/paths.mjs';

const compare = await loadJson('compare.json');
const subjects = compare.subjects;

const scoreDims = [
  { key: 'extensibility', label: '可扩展性' },
  { key: 'ecosystem', label: '生态' },
  { key: 'stability', label: '稳定性' },
  { key: 'ux', label: '体验' },
  { key: 'team', label: '团队/企业' },
  { key: 'docs', label: '文档' },
];

function polyPoints(scores: Record<string, number>, cx: number, cy: number, r: number) {
  return scoreDims.map((d, i) => {
    const angle = (360 / scoreDims.length) * i - 90;
    const rad = (angle * Math.PI) / 180;
    const val = (scores[d.key] || 0) / 100;
    const x = cx + r * val * Math.cos(rad);
    const y = cy + r * val * Math.sin(rad);
    return `${x},${y}`;
  }).join(' ');
}

const colors = ['#5eead4', '#a78bfa', '#fb923c', '#f472b6'];
const radarSize = 280;
---
<Layout title="横评 — DSH Radar" active="compare">
  <section class="container section">
    <h1 style="font-size:36px;margin-bottom:8px;">📊 横向对比</h1>
    <p class="sub">DSH vs BitFun vs Claude Code vs Cursor · 数据更新于 {compare.generated_at}</p>

    <div class="lead">
      这不是主观"哪个好"——而是把每个 Harness 在 <strong>6 个维度</strong>上量化打分。
      <br/>分数基于：插件数量、GitHub stars、文档完整度、社区活跃度、企业特性、价格可负担性。
    </div>

    <div class="info-block" style="margin-top:32px;">
      <h3>6 维度雷达对比</h3>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:24px;margin-top:16px;">
        {subjects.map((s: any, idx: number) => (
          <div style="text-align:center;">
            <svg viewBox={`0 0 ${radarSize} ${radarSize}`} style="width:100%;max-width:280px;">
              {[20, 40, 60, 80, 100].map((lv) => (
                <polygon
                  points={polyPoints(Object.fromEntries(scoreDims.map(d => [d.key, lv])), radarSize/2, radarSize/2, radarSize*0.4)}
                  fill="none" stroke="#232b3d" stroke-width="1"
                />
              ))}
              {scoreDims.map((d, i) => {
                const angle = (360 / scoreDims.length) * i - 90;
                const rad = (angle * Math.PI) / 180;
                const x = radarSize/2 + radarSize*0.4 * Math.cos(rad);
                const y = radarSize/2 + radarSize*0.4 * Math.sin(rad);
                return <line x1={radarSize/2} y1={radarSize/2} x2={x} y2={y} stroke="#232b3d" stroke-width="1"/>;
              })}
              <polygon points={polyPoints(s.score, radarSize/2, radarSize/2, radarSize*0.4)} fill={colors[idx]} fill-opacity="0.15" stroke={colors[idx]} stroke-width="2"/>
              {scoreDims.map((d, i) => {
                const angle = (360 / scoreDims.length) * i - 90;
                const rad = (angle * Math.PI) / 180;
                const x = radarSize/2 + radarSize*0.48 * Math.cos(rad);
                const y = radarSize/2 + radarSize*0.48 * Math.sin(rad);
                return <text x={x} y={y} text-anchor="middle" fill="#8b96a8" font-size="11" font-family="monospace">{d.label}</text>;
              })}
            </svg>
            <div style={`margin-top:8px;font-weight:600;color:${colors[idx]};`}>{s.name}</div>
          </div>
        ))}
      </div>
    </div>

    <div class="info-block" style="margin-top:32px;overflow-x:auto;">
      <h3>详细对比</h3>
      <table class="matrix-table" style="margin-top:16px;">
        <thead>
          <tr>
            <th>维度</th>
            {subjects.map((s: any, i: number) => <th style={`color:${colors[i]};`}>{s.short}</th>)}
          </tr>
        </thead>
        <tbody>
          <tr><td><strong>类型</strong></td>{subjects.map((s: any) => <td>{s.type}</td>)}</tr>
          <tr><td><strong>License</strong></td>{subjects.map((s: any) => <td><code>{s.license}</code></td>)}</tr>
          <tr><td><strong>Stars</strong></td>{subjects.map((s: any) => <td>★ {s.stars?.toLocaleString() || '—'}</td>)}</tr>
          <tr><td><strong>首发</strong></td>{subjects.map((s: any) => <td>{s.first_release}</td>)}</tr>
          <tr><td><strong>插件数</strong></td>{subjects.map((s: any) => <td>{s.plugin_count.toLocaleString()}</td>)}</tr>
          <tr><td><strong>插件生态</strong></td>{subjects.map((s: any) => <td style="font-size:12px;color:var(--text-dim);">{s.plugin_ecosystem}</td>)}</tr>
          <tr><td><strong>平台</strong></td>{subjects.map((s: any) => <td>{s.platform}</td>)}</tr>
          <tr><td><strong>可扩展性</strong></td>{subjects.map((s: any) => <td style="font-size:13px;color:var(--text-dim);">{s.extensibility}</td>)}</tr>
          <tr><td><strong>自我修改</strong></td>{subjects.map((s: any) => <td>{s.self_modify ? '✅' : '❌'}</td>)}</tr>
          <tr><td><strong>多 Agent</strong></td>{subjects.map((s: any) => <td style="font-size:13px;">{s.multi_agent}</td>)}</tr>
          <tr><td><strong>MCP</strong></td>{subjects.map((s: any) => <td>{s.mcp_support ? '✅' : '❌'}</td>)}</tr>
          <tr><td><strong>Web UI</strong></td>{subjects.map((s: any) => <td>{s.web_ui ? '✅' : '❌'}</td>)}</tr>
          <tr><td><strong>价格</strong></td>{subjects.map((s: any) => <td><code>{s.team_pricing}</code></td>)}</tr>
          <tr><td><strong>适合谁</strong></td>{subjects.map((s: any) => <td style="font-size:13px;color:var(--text-dim);">{s.best_for}</td>)}</tr>
        </tbody>
      </table>
    </div>

    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:16px;margin-top:32px;">
      {subjects.map((s: any, idx: number) => (
        <div class="info-block" style={`margin:0;border-top:3px solid ${colors[idx]};`}>
          <h3 style={`color:${colors[idx]};`}>{s.name}</h3>
          <div style="margin:12px 0;">
            <h4 style="font-size:12px;color:var(--good);text-transform:uppercase;margin-bottom:6px;">✅ 优点</h4>
            <ul style="list-style:none;padding:0;font-size:13px;color:var(--text-dim);">
              {s.pros.map((p: string) => <li style="padding:3px 0;">· {p}</li>)}
            </ul>
          </div>
          <div>
            <h4 style="font-size:12px;color:var(--bad);text-transform:uppercase;margin-bottom:6px;">❌ 缺点</h4>
            <ul style="list-style:none;padding:0;font-size:13px;color:var(--text-dim);">
              {s.cons.map((c: string) => <li style="padding:3px 0;">· {c}</li>)}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </section>
</Layout>
