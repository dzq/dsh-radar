---
import Layout from '../../layouts/Layout.astro';
import { loadJson } from '../../lib/paths.mjs';

const stats = await loadJson('stats.json');
const index = await loadJson('index.json');

// 当前周报
const currentReport = {
  id: '2026-w33',
  title: 'DSH 生态周报 #1 · 2026-W33',
  date: '2026-08-16',
  summary: 'DSH 生态 711 个插件首次全量评分完成 · 1S / 3A / 147B / 549C / 11D',
};

// 历史周报列表（占位）
const pastReports: any[] = [];
---
<Layout title="周报 — DSH Radar" active="reports">
  <section class="container section">
    <h1 style="font-size:36px;margin-bottom:8px;">📅 周报</h1>
    <p class="sub">DSH 生态每周数据报告 · 自动生成</p>

    <div class="lead">
      每周一 GitHub Actions 自动跑数据 + 生成周报。结构：
      <strong>新增插件</strong> · <strong>头部变化</strong> · <strong>等级变化</strong> · <strong>下载趋势</strong> · <strong>本周看点</strong>。
    </div>

    {/* 周报 + 日报 并排卡片 */}
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:16px;margin-top:32px;">

      {/* 周报 */}
      <a href={`/reports/${currentReport.id}`} style="background:var(--bg-elev);border:1px solid var(--border);border-radius:12px;padding:24px;text-decoration:none;display:flex;flex-direction:column;gap:12px;transition:border-color 0.15s;box-shadow:var(--shadow);">
        <div style="display:flex;align-items:center;gap:8px;">
          <span style="background:var(--accent);color:#0a0e1a;padding:3px 10px;border-radius:6px;font-weight:700;font-size:12px;">📋 周报</span>
          <span style="color:var(--text-mute);font-size:12px;">{currentReport.date}</span>
        </div>
        <div style="flex:1;">
          <h3 style="font-size:18px;color:var(--text);margin-bottom:6px;">{currentReport.title}</h3>
          <p style="color:var(--text-dim);font-size:13px;line-height:1.6;">{currentReport.summary}</p>
        </div>
        <div style="padding-top:12px;border-top:1px solid var(--border);">
          <span style="color:var(--accent);font-size:13px;font-weight:600;">阅读全文 →</span>
        </div>
      </a>

      {/* 日报 */}
      <a href="/reports/daily" style="background:var(--bg-elev);border:1px solid var(--border);border-radius:12px;padding:24px;text-decoration:none;display:flex;flex-direction:column;gap:12px;transition:border-color 0.15s;box-shadow:var(--shadow);">
        <div style="display:flex;align-items:center;gap:8px;">
          <span style="background:var(--accent);color:#0a0e1a;padding:3px 10px;border-radius:6px;font-weight:700;font-size:12px;">📅 日报</span>
          <span style="color:var(--text-mute);font-size:12px;">每日更新</span>
        </div>
        <div style="flex:1;">
          <h3 style="font-size:18px;color:var(--text);margin-bottom:6px;">每日数据快照</h3>
          <p style="color:var(--text-dim);font-size:13px;line-height:1.6;">每日更新 · 新增/跌出插件 · 等级分布 · 趋势变化</p>
        </div>
        <div style="padding-top:12px;border-top:1px solid var(--border);">
          <span style="color:var(--accent);font-size:13px;font-weight:600;">查看日报 →</span>
        </div>
      </a>

    </div>

    {/* 历史列表（占位） */}
    <h2 style="margin-top:48px;font-size:24px;">历史周报</h2>
    {pastReports.length === 0 ? (
      <div class="empty">
        <h3 style="color:var(--text);margin-bottom:8px;">📭 暂无历史</h3>
        <p>每周构建自动生成新周报。第一次是 W33（本期）。</p>
        <p style="margin-top:12px;font-size:13px;color:var(--text-mute);">
          配置 GitHub Actions（见 <a href="/tutorials/github-actions">教程</a>）后，每周自动累积。
        </p>
      </div>
    ) : (
      <div style="display:grid;gap:12px;margin-top:16px;">
        {pastReports.map((r: any) => (
          <a href={`/reports/${r.id}`} class="info-block" style="margin:0;text-decoration:none;">
            <h4 style="font-size:18px;color:var(--text);">{r.title}</h4>
            <p style="color:var(--text-dim);font-size:13px;margin-top:4px;">{r.summary}</p>
          </a>
        ))}
      </div>
    )}

    <div class="empty" style="margin-top:48px;">
      <h3 style="color:var(--text);margin-bottom:8px;">📬 订阅周报</h3>
      <p>用 <a href="/feeds/rss.xml">RSS</a> / <a href="/subscribe">邮件订阅</a>，每周一自动收到。</p>
    </div>
  </section>
</Layout>
