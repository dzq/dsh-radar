---
import Layout from '../../layouts/Layout.astro';
import { loadJson } from '../../lib/paths.mjs';

const stats = await loadJson('stats.json');
const index = await loadJson('index.json');

// 当前数据
const total = stats.total;
const weeklyDl = stats.total_weekly_downloads;
const compatCount = stats.by_compat;
const compatRate = ((compatCount / total) * 100).toFixed(1);

// 头部插件
const top5 = index.plugins.slice(0, 5);

// 等级分布
const gradeDist = [
  { grade: 'S', count: stats.by_grade.S || 0, color: 'var(--grade-S)', desc: '卓越' },
  { grade: 'A', count: stats.by_grade.A || 0, color: 'var(--grade-A)', desc: '优秀' },
  { grade: 'B', count: stats.by_grade.B || 0, color: 'var(--grade-B)', desc: '良好' },
  { grade: 'C', count: stats.by_grade.C || 0, color: 'var(--grade-C)', desc: '一般' },
  { grade: 'D', count: stats.by_grade.D || 0, color: 'var(--grade-D)', desc: '待改进' },
];

// 最新快照时间
const snapshotTime = new Date(stats.generated_at).toLocaleString('zh-CN', {
  month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit',
});
const today = new Date().toLocaleDateString('zh-CN', { month: '2-digit', day: '2-digit' });
---
<Layout title={`日报 ${today} — DSH Radar`} active="reports">
  <section class="container section" style="padding-top:32px;">
    {/* 标题栏 */}
    <div style="display:flex;align-items:center;gap:12px;margin-bottom:8px;">
      <span style="background:var(--accent);color:#0a0e1a;padding:4px 12px;border-radius:6px;font-weight:700;font-size:13px;">日报</span>
      <span style="color:var(--text-mute);font-size:13px;">{today} · 数据更新 {snapshotTime}</span>
    </div>
    <h1 style="font-size:36px;margin-bottom:24px;">📅 DSH 生态日报</h1>

    {/* 核心指标 */}
    <div class="stats-grid">
      <div class="stat-card">
        <span class="num">{total}</span>
        <span class="label">评分插件</span>
      </div>
      <div class="stat-card">
        <span class="num">{(weeklyDl / 1000).toFixed(1)}k</span>
        <span class="label">周下载</span>
      </div>
      <div class="stat-card">
        <span class="num">{compatRate}%</span>
        <span class="label">DSH 兼容率</span>
      </div>
      <div class="stat-card">
        <span class="num" style="color:var(--grade-S);">{stats.by_grade.S || 0}</span>
        <span class="label">S 级</span>
      </div>
      <div class="stat-card">
        <span class="num" style="color:var(--grade-A);">{stats.by_grade.A || 0}</span>
        <span class="label">A 级</span>
      </div>
    </div>

    {/* 等级分布 */}
    <h2 style="margin-top:48px;font-size:24px;">🏆 等级分布</h2>
    <div style="display:flex;gap:12px;margin-top:16px;flex-wrap:wrap;">
      {gradeDist.map(g => (
        <div style="flex:1;min-width:100px;background:var(--bg-elev);border:1px solid var(--border);border-radius:12px;padding:16px;text-align:center;">
          <div style={`width:36px;height:36px;line-height:36px;border-radius:8px;background:${g.color};color:#0a0e1a;font-weight:700;font-size:18px;margin:0 auto 8px;`}>{g.grade}</div>
          <div style="font-family:var(--mono);font-size:24px;font-weight:700;">{g.count}</div>
          <div style="font-size:12px;color:var(--text-mute);margin-top:4px;">{g.desc}</div>
        </div>
      ))}
    </div>

    {/* 头部插件 */}
    <h2 style="margin-top:48px;font-size:24px;">🏅 头部插件 Top 5</h2>
    <p style="color:var(--text-dim);margin-top:4px;">按综合评分排序</p>
    <div style="background:var(--bg-elev);border:1px solid var(--border);border-radius:12px;overflow:hidden;margin-top:16px;">
      {top5.map((p: any) => (
        <a href={`/plugins/${p.slug}`} class="plugin-row" style="text-decoration:none;">
          <span class={`grade grade-${p.grade}`}>{p.grade}</span>
          <div style="min-width:0;">
            <div class="name" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">{p.name}</div>
            <div class="desc" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">{p.description?.slice(0, 60) || '—'}</div>
          </div>
          <div class="meta" style="flex-shrink:0;"><strong>{p.weekly_downloads.toLocaleString()}</strong> dl/wk</div>
          <div class="meta" style="flex-shrink:0;"><strong>{p.overall}</strong> 分</div>
        </a>
      ))}
    </div>

    {/* 快速入口 */}
    <h2 style="margin-top:48px;font-size:24px;">🔍 发现好插件</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:16px;margin-top:16px;">
      <a href="/plugins" class="info-block" style="margin:0;text-decoration:none;text-align:center;">
        <div style="font-size:32px;margin-bottom:8px;">📦</div>
        <h3 style="font-size:16px;">全部插件</h3>
        <p style="color:var(--text-dim);font-size:13px;margin-top:4px;">{total} 个插件搜索 / 筛选 / 排序</p>
      </a>
      <a href="/authors" class="info-block" style="margin:0;text-decoration:none;text-align:center;">
        <div style="font-size:32px;margin-bottom:8px;">👥</div>
        <h3 style="font-size:16px;">活跃作者</h3>
        <p style="color:var(--text-dim);font-size:13px;margin-top:4px;">按插件数 / Stars 排名</p>
      </a>
      <a href="/recipes" class="info-block" style="margin:0;text-decoration:none;text-align:center;">
        <div style="font-size:32px;margin-bottom:8px;">📋</div>
        <h3 style="font-size:16px;">实战配方</h3>
        <p style="color:var(--text-dim);font-size:13px;margin-top:4px;">任务 → 插件组合</p>
      </a>
    </div>

    {/* 自动生成说明 */}
    <div class="empty" style="margin-top:48px;">
      <h3 style="color:var(--text);margin-bottom:8px;">🤖 自动生成</h3>
      <p>日报每日由 GitHub Actions 自动抓取 npm + GitHub 数据生成。</p>
      <p style="margin-top:8px;">订阅方式：<a href="/feeds/rss.xml">RSS</a> · <a href="/subscribe">邮件</a></p>
    </div>
  </section>
</Layout>
