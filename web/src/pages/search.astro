---
import Layout from '../layouts/Layout.astro';
import { loadJson } from '../lib/paths.mjs';

const stats = await loadJson('stats.json');
const totalPlugins = stats.total;
---
<Layout title="搜索插件 — DSH Radar" active="search">
  <section class="container section" style="padding-top:32px;">
    <h1 style="font-size:36px;margin-bottom:8px;">🔍 搜索插件</h1>
    <p class="sub">在 <strong>{totalPlugins}</strong> 个评分插件中实时搜索</p>

    {/* 搜索框 + 筛选 */}
    <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:24px;align-items:center;">
      <input
        id="q"
        type="search"
        placeholder="按名称 / 描述 / 关键词搜索…"
        autocomplete="off"
        style="flex:1;min-width:240px;padding:12px 16px;background:var(--bg-elev);border:1px solid var(--border);border-radius:8px;color:var(--text);font-size:15px;font-family:inherit;"
      />
      <select id="grade" style="padding:12px;background:var(--bg-elev);border:1px solid var(--border);border-radius:8px;color:var(--text);font-size:14px;">
        <option value="">全部等级</option>
        <option value="S">S 级</option>
        <option value="A">A 级</option>
        <option value="B">B 级</option>
        <option value="C">C 级</option>
        <option value="D">D 级</option>
      </select>
      <select id="sort" style="padding:12px;background:var(--bg-elev);border:1px solid var(--border);border-radius:8px;color:var(--text);font-size:14px;">
        <option value="o">按 Overall</option>
        <option value="w">按周下载</option>
        <option value="r">按 Stars</option>
        <option value="p">按最近发布</option>
        <option value="n">按名称</option>
      </select>
      <label style="display:flex;align-items:center;gap:6px;font-size:14px;color:var(--text-dim);cursor:pointer;">
        <input type="checkbox" id="compat" /> 仅 DSH 标准
      </label>
    </div>

    <p style="font-size:13px;color:var(--text-mute);margin:16px 0;">
      加载中… <span id="count">0</span> 个结果
    </p>

    {/* 客户端渲染容器 */}
    <div id="results" style="background:var(--bg-elev);border:1px solid var(--border);border-radius:12px;overflow:hidden;min-height:100px;"></div>

    <div id="empty" class="empty" style="display:none;margin-top:16px;">
      🔍 没有匹配项 — 试试别的关键词，或 <a href="https://github.com/dsh-radar/dsh-radar/issues/new">建议收录</a>
    </div>
  </section>
</Layout>

<script is:inline>
(function() {
  var q = document.getElementById('q');
  var grade = document.getElementById('grade');
  var sort = document.getElementById('sort');
  var compat = document.getElementById('compat');
  var countEl = document.getElementById('count');
  var results = document.getElementById('results');
  var empty = document.getElementById('empty');
  var allRows = [];

  // 加载搜索索引（懒加载，~260KB gzip 后约 50KB）
  fetch('/search-index.json').then(function(r) { return r.json(); }).then(function(data) {
    allRows = data.map(function(p) {
      return {
        slug: p.s,
        name: p.n,
        version: p.v,
        desc: p.d,
        keywords: (p.k || []).join(' ').toLowerCase(),
        grade: p.g,
        overall: p.o,
        weekly: p.w,
        stars: p.r,
        publish: p.p || '',
        compat: p.c,
        nameLow: p.n.toLowerCase(),
        descLow: (p.d || '').toLowerCase(),
      };
    });
    countEl.textContent = allRows.length;
    apply();
  }).catch(function() {
    results.innerHTML = '<div class="empty">⚠️ 搜索索引加载失败</div>';
  });

  function rowHtml(p) {
    return '<a href="/plugins/' + p.slug + '" class="plugin-row" style="text-decoration:none;">' +
      '<span class="grade grade-' + p.grade + '">' + p.grade + '</span>' +
      '<div>' +
        '<div class="name">' + escapeHtml(p.name) + '<span class="version">v' + escapeHtml(p.version) + '</span></div>' +
        '<div class="desc">' + escapeHtml(p.desc || '—') + '</div>' +
      '</div>' +
      '<div class="meta"><strong>' + p.weekly.toLocaleString() + '</strong>dl/wk</div>' +
      '<div class="meta"><strong>★ ' + p.stars + '</strong>stars</div>' +
      '<div class="meta"><strong>' + p.overall + '</strong>overall</div>' +
    '</a>';
  }

  function escapeHtml(s) {
    return String(s).replace(/[<>&"']/g, function(c) {
      return { '<': '&lt;', '>': '&gt;', '&': '&amp;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }

  function apply() {
    var term = (q.value || '').trim().toLowerCase();
    var g = grade.value;
    var c = compat.checked;
    var filtered = allRows.filter(function(p) {
      if (g && p.grade !== g) return false;
      if (c && !p.compat) return false;
      if (term) {
        if (p.nameLow.indexOf(term) === -1 &&
            p.descLow.indexOf(term) === -1 &&
            p.keywords.indexOf(term) === -1) return false;
      }
      return true;
    });

    var sortKey = sort.value;
    filtered.sort(function(a, b) {
      if (sortKey === 'n') return a.nameLow.localeCompare(b.nameLow);
      if (sortKey === 'p') return (b.publish || '').localeCompare(a.publish || '');
      return (b[sortKey] || 0) - (a[sortKey] || 0);
    });

    countEl.textContent = filtered.length;
    if (filtered.length === 0) {
      results.innerHTML = '';
      empty.style.display = '';
    } else {
      empty.style.display = 'none';
      results.innerHTML = filtered.map(rowHtml).join('');
    }
  }

  function sync() {
    var p = new URLSearchParams();
    if (q.value) p.set('q', q.value);
    if (grade.value) p.set('grade', grade.value);
    if (sort.value !== 'o') p.set('sort', sort.value);
    if (compat.checked) p.set('compat', '1');
    history.replaceState(null, '', p.toString() ? '?' + p : location.pathname);
  }

  [q, grade, sort, compat].forEach(function(el) {
    el.addEventListener('input', function() { apply(); sync(); });
    el.addEventListener('change', function() { apply(); sync(); });
  });

  // URL 初始化
  var params = new URLSearchParams(location.search);
  if (params.get('q')) q.value = params.get('q');
  if (params.get('grade')) grade.value = params.get('grade');
  if (params.get('sort')) sort.value = params.get('sort');
  if (params.get('compat')) compat.checked = params.get('compat') === '1';
})();
</script>
